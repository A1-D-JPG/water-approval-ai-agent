# Copy this file to .env and fill your own values.
# Do not commit .env to Git.

OPENAI_API_KEY=your-api-key
OPENAI_MODEL=gpt-4o-mini

# Optional. Use this only when your provider is OpenAI-compatible but not the official OpenAI endpoint.
# Example: https://api.openai.com/v1
OPENAI_BASE_URL=

# DeepSeek is OpenAI-compatible, so either of the following formats works:
# OPENAI_API_KEY=your-deepseek-api-key
# OPENAI_MODEL=deepseek-chat
# OPENAI_BASE_URL=https://api.deepseek.com/v1
#
# The service also accepts shorter aliases used in class demonstrations:
# API_KEY=your-deepseek-api-key
# AI_MODEL=deepseek-chat
# AI_BASE_URL=https://api.deepseek.com/v1
